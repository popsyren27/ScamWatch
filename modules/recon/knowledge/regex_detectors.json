{
  "entries": [
    {
      "category": "fake_gateway",
      "label": "Telegram bot-API payment/exfil endpoint",
      "severity": "high",
      "weight": 14,
      "pattern": "api\\.telegram\\.org/bot[\\w:-]+",
      "ignore_case": true
    },
    {
      "category": "offsite_contact",
      "label": "Off-platform Telegram contact",
      "severity": "medium",
      "weight": 6,
      "pattern": "(?:https?://)?t\\.me/[A-Za-z0-9_]{3,}",
      "ignore_case": true
    },
    {
      "category": "offsite_contact",
      "label": "Off-platform WhatsApp contact",
      "severity": "medium",
      "weight": 6,
      "pattern": "(?:https?://)?(?:wa\\.me|api\\.whatsapp\\.com|chat\\.whatsapp\\.com)/[\\w/%+.-]+",
      "ignore_case": true
    },
    {
      "category": "offsite_contact",
      "label": "Off-platform Viber contact",
      "severity": "medium",
      "weight": 5,
      "pattern": "viber://(?:chat|add|pa)\\?[\\w=&%.+-]+",
      "ignore_case": true
    },
    {
      "category": "offsite_contact",
      "label": "Off-platform Messenger contact",
      "severity": "low",
      "weight": 4,
      "pattern": "(?:https?://)?m\\.me/[A-Za-z0-9\\.]{3,}",
      "ignore_case": true
    },
    {
      "category": "suspicious_link",
      "label": "Lookalike e-wallet/bank domain on a throwaway TLD",
      "severity": "high",
      "weight": 12,
      "pattern": "\\b(?:gcash|maya|paymaya|bpi|bdo|unionbank|landbank|metrobank)[\\w-]*\\.(?:xyz|top|tk|ml|ga|cf|gq|icu|live|online|site|club|fun|shop|store|buzz|cyou|sbs|rest|click|link)\\b",
      "ignore_case": true
    },
    {
      "category": "wallet_address",
      "label": "Bitcoin wallet address",
      "severity": "medium",
      "weight": 8,
      "pattern": "\\b(?:bc1[a-z0-9]{25,90}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})\\b",
      "ignore_case": false
    },
    {
      "category": "wallet_address",
      "label": "Ethereum / ERC-20 wallet address",
      "severity": "medium",
      "weight": 8,
      "pattern": "\\b0x[a-fA-F0-9]{40}\\b",
      "ignore_case": false
    },
    {
      "category": "wallet_address",
      "label": "USDT-TRON (TRC-20) wallet address",
      "severity": "medium",
      "weight": 8,
      "pattern": "\\bT[1-9A-HJ-NP-Za-km-z]{33}\\b",
      "ignore_case": false
    },
    {
      "category": "peso_amount",
      "label": "Peso amount solicited on page",
      "severity": "low",
      "weight": 4,
      "pattern": "(?:₱|php\\s?|p(?=\\d))\\d{1,3}(?:,\\d{3})+(?:\\.\\d{2})?",
      "ignore_case": true
    },
    {
      "category": "ph_mobile",
      "label": "Philippine mobile number (collection/contact)",
      "severity": "low",
      "weight": 4,
      "pattern": "(?:\\+?63|0)9\\d{2}[\\s-]?\\d{3}[\\s-]?\\d{4}\\b",
      "ignore_case": false
    },
    {
      "category": "malware_download",
      "label": "Forced download of an executable/installer",
      "severity": "high",
      "weight": 12,
      "pattern": "href\\s*=\\s*[\\\"'][^\\\"']+\\.(?:apk|exe|scr|msi|bat|dmg)[\\\"']",
      "ignore_case": true
    }
  ]
}